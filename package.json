{
  "name": "jamlink",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Low-latency 2-player guitar jam in the browser: raw PCM over an unordered WebRTC DataChannel.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "preview": "npm run build && wrangler dev",
    "e2e": "npm run build && playwright test",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250927.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.8",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.0"
  }
}
